{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope_Session",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent_jit.session"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/SessionId"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "body": {
      "$ref": "#/$defs/Session"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "provenance",
    "body"
  ],
  "$defs": {
    "Session": {
      "description": "One agent session against one repository worktree.",
      "type": "object",
      "properties": {
        "repository_id": {
          "description": "Repository the session ran against.",
          "$ref": "#/$defs/RepositoryId"
        },
        "worktree_root": {
          "description": "Absolute path of the worktree the session ran in.",
          "type": "string"
        },
        "head_commit": {
          "description": "Commit checked out when the session started.",
          "type": "string"
        },
        "runtime": {
          "description": "Runtime that produced the session.",
          "$ref": "#/$defs/Runtime"
        },
        "runtime_version": {
          "description": "Exact runtime version, e.g. the Claude Code CLI version.",
          "type": "string"
        },
        "model_id": {
          "description": "Explicit model identifier; never inferred or defaulted.",
          "type": "string"
        },
        "recorder_version": {
          "description": "Version of the recorder plugin that captured the session.",
          "type": "string"
        },
        "started_at_unix_ms": {
          "description": "Wall-clock start. Volatile: excluded from the digest.",
          "type": "integer",
          "format": "int64"
        },
        "ended_at_unix_ms": {
          "description": "Wall-clock end, absent while the session is open. Volatile: excluded from the digest.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository_id",
        "worktree_root",
        "head_commit",
        "runtime",
        "runtime_version",
        "model_id",
        "recorder_version",
        "started_at_unix_ms"
      ]
    },
    "RepositoryId": {
      "description": "Identifier for a Repository record.",
      "type": "string",
      "pattern": "^rep_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Runtime": {
      "description": "The agent runtime a session was recorded from.",
      "oneOf": [
        {
          "description": "Claude Code, the only runtime instrumented in v1.",
          "type": "string",
          "const": "claude_code"
        }
      ]
    },
    "SessionId": {
      "description": "Identifier for a Session record.",
      "type": "string",
      "pattern": "^ses_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Provenance": {
      "description": "Provenance recorded alongside every envelope.",
      "type": "object",
      "properties": {
        "produced_by": {
          "description": "Name and version of the component that produced the record, e.g. `agent-jit/0.1.0`.",
          "type": "string"
        },
        "source": {
          "description": "How the record entered the system.",
          "$ref": "#/$defs/ProvenanceSource"
        },
        "recorded_at_unix_ms": {
          "description": "Wall-clock time the record was produced. Volatile: never part of a digest.",
          "type": "integer",
          "format": "int64"
        },
        "parents": {
          "description": "Digests of the records this one was derived from, in a stable order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "produced_by",
        "source",
        "recorded_at_unix_ms"
      ]
    },
    "ProvenanceSource": {
      "description": "How a record entered the system.",
      "oneOf": [
        {
          "description": "Captured live from agent hooks.",
          "type": "string",
          "const": "recorded"
        },
        {
          "description": "Imported from an exact-shape historical record.",
          "type": "string",
          "const": "imported"
        },
        {
          "description": "Derived from other records already in the store.",
          "type": "string",
          "const": "derived"
        },
        {
          "description": "Confirmed by a human operator.",
          "type": "string",
          "const": "confirmed"
        }
      ]
    },
    "Digest": {
      "description": "BLAKE3 digest of a canonical JSON byte string, lowercase hex.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
