{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope_BenchmarkRecord",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent_jit.benchmark_record"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/BenchmarkId"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "body": {
      "$ref": "#/$defs/BenchmarkRecord"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "provenance",
    "body"
  ],
  "$defs": {
    "BenchmarkRecord": {
      "description": "One task, run once, in one condition.",
      "type": "object",
      "properties": {
        "repository_id": {
          "description": "Repository the task ran against.",
          "$ref": "#/$defs/RepositoryId"
        },
        "task_id": {
          "description": "Stable task identifier from the pre-frozen task set.",
          "type": "string"
        },
        "condition": {
          "description": "Which arm produced this record.",
          "$ref": "#/$defs/BenchmarkCondition"
        },
        "order_index": {
          "description": "Position of this record in the counterbalanced order, starting at zero.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "head_commit": {
          "description": "Commit the task ran against, pinned per task.",
          "type": "string"
        },
        "model_id": {
          "description": "Explicit model identifier used for the run.",
          "type": "string"
        },
        "metrics": {
          "description": "Measured cost of the run.",
          "$ref": "#/$defs/CostMetrics"
        },
        "correctness": {
          "description": "Correctness verdict from the deterministic oracle.",
          "$ref": "#/$defs/CorrectnessVerdict"
        },
        "capability_id": {
          "description": "Capability that was eligible during a treatment run, when one was.",
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "capability_executed": {
          "description": "Whether the capability actually executed, as opposed to being merely available.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository_id",
        "task_id",
        "condition",
        "order_index",
        "head_commit",
        "model_id",
        "metrics",
        "correctness",
        "capability_executed"
      ]
    },
    "RepositoryId": {
      "description": "Identifier for a Repository record.",
      "type": "string",
      "pattern": "^rep_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "BenchmarkCondition": {
      "description": "Which arm of the paired benchmark produced a record.",
      "oneOf": [
        {
          "description": "The agent ran with no JIT tool available.",
          "type": "string",
          "const": "baseline"
        },
        {
          "description": "The agent ran with exactly one enabled capability available.",
          "type": "string",
          "const": "treatment"
        }
      ]
    },
    "CostMetrics": {
      "description": "Integer cost metrics for one run.\n\nEvery value is an integer: canonical JSON rejects floats, because a digest that depends on\nfloat formatting is not reproducible. Ratios are computed at report time from these counters,\nnever stored.",
      "type": "object",
      "properties": {
        "tool_calls": {
          "description": "Number of tool calls the agent made.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "agent_turns": {
          "description": "Number of agent turns.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "estimated_input_tokens": {
          "description": "Estimated input tokens consumed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "estimated_output_tokens": {
          "description": "Estimated output tokens produced.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "duration_ms": {
          "description": "Wall-clock duration of the run.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "tool_calls",
        "agent_turns",
        "estimated_input_tokens",
        "estimated_output_tokens",
        "duration_ms"
      ]
    },
    "CorrectnessVerdict": {
      "description": "The verdict of the deterministic correctness oracle for one task.",
      "oneOf": [
        {
          "description": "The task output matched the oracle exactly.",
          "type": "string",
          "const": "correct"
        },
        {
          "description": "The task output did not match the oracle.",
          "type": "string",
          "const": "incorrect"
        },
        {
          "description": "The oracle could not be evaluated, which counts as a failure for gating purposes.",
          "type": "string",
          "const": "indeterminate"
        }
      ]
    },
    "CapabilityId": {
      "description": "Identifier for a Capability record.",
      "type": "string",
      "pattern": "^cap_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "BenchmarkId": {
      "description": "Identifier for a Benchmark record.",
      "type": "string",
      "pattern": "^bmk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Provenance": {
      "description": "Provenance recorded alongside every envelope.",
      "type": "object",
      "properties": {
        "produced_by": {
          "description": "Name and version of the component that produced the record, e.g. `agent-jit/0.1.0`.",
          "type": "string"
        },
        "source": {
          "description": "How the record entered the system.",
          "$ref": "#/$defs/ProvenanceSource"
        },
        "recorded_at_unix_ms": {
          "description": "Wall-clock time the record was produced. Volatile: never part of a digest.",
          "type": "integer",
          "format": "int64"
        },
        "parents": {
          "description": "Digests of the records this one was derived from, in a stable order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "produced_by",
        "source",
        "recorded_at_unix_ms"
      ]
    },
    "ProvenanceSource": {
      "description": "How a record entered the system.",
      "oneOf": [
        {
          "description": "Captured live from agent hooks.",
          "type": "string",
          "const": "recorded"
        },
        {
          "description": "Imported from an exact-shape historical record.",
          "type": "string",
          "const": "imported"
        },
        {
          "description": "Derived from other records already in the store.",
          "type": "string",
          "const": "derived"
        },
        {
          "description": "Confirmed by a human operator.",
          "type": "string",
          "const": "confirmed"
        }
      ]
    },
    "Digest": {
      "description": "BLAKE3 digest of a canonical JSON byte string, lowercase hex.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
